# Meta for Developers > WhatsApp > API Setup sayfasından alınır
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# İlk mesaj için Meta'ya onaylattığınız şablonun adı (Meta > WhatsApp Manager > Message Templates)
WHATSAPP_TEMPLATE_NAME=good_invest_ilk_mesaj
WHATSAPP_TEMPLATE_LANGUAGE=tr

# Webhook doğrulaması için siz belirlersiniz (Meta App Dashboard'da webhook kurarken aynısını girin)
WHATSAPP_VERIFY_TOKEN=degistir-bu-gizli-bir-anahtar

# autoReplyServer.ts'in dinleyeceği port
PORT=3000
